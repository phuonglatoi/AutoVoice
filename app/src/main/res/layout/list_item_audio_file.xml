<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/list_item_selector_with_border">

    <ImageView
        android:id="@+id/ivAudioIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_audio_file"
        android:layout_marginEnd="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.5"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvAudioFileName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên File Audio.mp3"
            android:textColor="#374151"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAudioOriginalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Một đoạn văn bản gốc ngắn..."
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvAudioDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Creation Date: 14/05/2025"
            android:textSize="15sp"
            android:textColor="#4B5563"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnItemPlayAudio"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_play_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#484B50"
            android:scaleType="centerInside"
            android:contentDescription="Nghe"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnItemDownloadAudio"
        android:layout_width="40dp"
        android:layout_height="40dp" android:layout_weight="1"
        android:src="@drawable/ic_download_icon"
        android:background="?attr/selectableItemBackgroundBorderless" app:tint="#484B50" android:scaleType="centerInside"
        android:contentDescription="Tải xuống"
        android:layout_marginStart="8dp"/>

</LinearLayout>
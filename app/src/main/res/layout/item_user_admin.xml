<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_user_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_user_placeholder" /> <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="8dp">

    <TextView
        android:id="@+id/tv_item_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_item_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="email@example.com"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_item_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vai trò: User"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_item_subscription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gói: Free"
        android:textSize="12sp" />
</LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageButton
            android:id="@+id/btn_edit_user_password"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_edit_password"  android:tooltipText="Sửa mật khẩu"
            app:tint="?attr/colorControlNormal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sửa mật khẩu người dùng"
            android:scaleType="centerInside"/>

        <ImageButton
            android:id="@+id/btn_upgrade_package"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_upgrade_package"  android:tooltipText="Nâng cấp gói"
            app:tint="?attr/colorControlNormal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Nâng cấp gói người dùng"
            android:layout_marginTop="4dp"
            android:scaleType="centerInside"/>

        <ImageButton
            android:id="@+id/btn_delete_user"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete_user"  android:tooltipText="Xóa người dùng"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa người dùng"
            android:layout_marginTop="4dp"
            android:scaleType="centerInside"/>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogUpgradeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nâng Cấp Gói Dịch Vụ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvUserInfoForPackageUpgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Người dùng: username_placeholder"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tvCurrentUserPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gói hiện tại: Free"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn gói mới:"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <Spinner
        android:id="@+id/spinnerNewPackage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        style="@style/Widget.AppCompat.Spinner.Underlined"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>

</LinearLayout>

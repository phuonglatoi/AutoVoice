<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgOnboardingSlide"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.MediumComponent.Rounded"
        android:src="@drawable/onboarding_image_1" /> <TextView
    android:id="@+id/tvOnboardingTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp"
    android:text="Khám Phá Tính Năng Mới" android:textSize="24sp"
    android:fontFamily="sans-serif-medium"
    android:textColor="@color/text_primary_color"
    android:gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tvOnboardingDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:text="Mô tả chi tiết về cách ứng dụng giúp bạn giải quyết vấn đề hoặc mang lại lợi ích." android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_secondary_color"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="1.2"/>

</LinearLayout>

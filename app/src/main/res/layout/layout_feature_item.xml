<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground" > <TextView
    android:id="@+id/tvItemAudioFileName"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="2.5"
    tools:text="user_2/output_16GZ1wD.mp3"
    android:textColor="#374151" android:textSize="13sp"
    android:maxLines="2"
    android:ellipsize="end"/>

    <TextView
        android:id="@+id/tvItemAudioCreatedAt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        tools:text="April 18, 2025, 4:46 am"
        android:textColor="#6B7280" android:textSize="13sp"
        android:layout_marginStart="8dp"
        android:maxLines="2"
        android:ellipsize="end"/>

    <LinearLayout
        android:id="@+id/llItemAudioPlayControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:gravity="center_vertical|center_horizontal"
        android:layout_marginStart="8dp">

        <ImageButton
            android:id="@+id/ibItemAudioPlayPause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_play_arrow" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play/Pause"
            app:tint="#6B7280"/> <TextView
        android:id="@+id/tvItemAudioDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="0:00/2:25"
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:layout_marginStart="4dp"
        android:visibility="visible"/> </LinearLayout>

    <Button
        android:id="@+id/btnItemAudioDownload"
        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="Download"
        android:textSize="12sp"
        android:textColor="@color/app_primary_color"
        app:icon="@drawable/ic_download" app:iconTint="@color/app_primary_color"
        app:iconGravity="textStart"
        android:backgroundTint="@android:color/transparent"
        android:layout_gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"/>

</LinearLayout>
